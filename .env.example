# Database
DATABASE_URL="postgresql://user:password@localhost:5432/focustrack?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Email (Resend or SMTP)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="noreply@focustrack.dev"

# AI Provider (agnostic)
# options: openai, anthropic, google, groq, ollama
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_API_KEY="sk-..."

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Cron security
CRON_SECRET="super-secret-cron-token"

# External APIs (optional)
CODEFORCES_API_URL="https://codeforces.com/api"
CODECHEF_CONTEST_URL="https://www.codechef.com/api/list/contests/all"
FALLBACK_CONTEST_API="https://kontests.net/api/v1/all"

# Ollama (optional, for local AI)
OLLAMA_BASE_URL="http://localhost:11434"

# News
HACKER_NEWS_API="https://hacker-news.firebaseio.com/v0"
DEVTO_API="https://dev.to/api"
# RSS feeds (optional, defaults in code: freeCodeCamp, CSS-Tricks, AI News)
FCC_RSS="https://www.freecodecamp.org/news/rss/"
CSS_TRICKS_RSS="https://css-tricks.com/feed/"
AI_NEWS_RSS="https://www.artificialintelligence-news.com/feed/"

# PWA / Notifications (no env needed, browser APIs)
# NEXT_PUBLIC_CRON_SECRET is NOT recommended – CRON_SECRET stays server-only
